{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./web/dist",
    "baseUrl": "./",
    "paths": {
      "@package": ["package.json"],
      "@/*": ["web/src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "web/src/**/*"
  ]
}
